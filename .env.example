# Copy this file to .env and fill in real values: cp .env.example .env
# (PowerShell: Copy-Item .env.example .env)
# .env is git-ignored - never commit real secrets.
# Lines starting with # are comments and are skipped by the loader
# (see services/shared/config.py). Do NOT put a comment at the end of a
# value line - only whole-line comments are supported.

# --- Database (used by every service that talks to Postgres) ---
# "postgres" = the Docker Compose service name - use this when running via
# `docker compose up`. Override to 127.0.0.1 in your local .env only if
# running a service natively, outside Docker, for debugging.
DB_HOST=postgres
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=webhawk

# --- JWT (used only by the users service) ---
# Generate a real secret rather than typing one - see the README's Setup
# section for the exact command on Windows/Mac/Linux.
JWT_SECRET=change_this_secret
# Supported: HS256, HS384, HS512
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# --- Rate limiting (used only by the security-engine service) ---
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECS=60