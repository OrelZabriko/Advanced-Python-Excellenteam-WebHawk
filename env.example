# ============================================================
# WebHawk (Python / Flask) - environment template
# ============================================================
# Copy this file to .env and fill in real values:
#   Windows PowerShell:  Copy-Item .env.example .env
#   Windows CMD:         copy .env.example .env
#
# .env is git-ignored - never commit real secrets.
#
# This file is read by two independent mechanisms:
#   1. python-dotenv (load_dotenv() in services/shared/config.py) - used when
#      a service runs natively on Windows, outside Docker.
#   2. Docker Compose itself, which substitutes ${VAR} anywhere in
#      docker-compose.yml from a file literally named .env at the repo root.
#      That's how the postgres container gets its POSTGRES_USER/PASSWORD/DB
#      without hardcoding them in the compose file.
#
# Syntax rule: each line must be KEY=VALUE with no spaces around '=' and no
# trailing comment on a value line. Only whole-line comments (starting with
# '#') are safe.


# --- Database (used by every service that talks to Postgres) ---
# DB_HOST=postgres is the Docker Compose service name, resolved by Docker's
# internal DNS. When running a service natively on Windows while Postgres
# runs in Docker, override this to 127.0.0.1 in your local .env.
DB_HOST=postgres
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=webhawk


# --- JWT (used only by the users service) ---
# Generate a real secret rather than typing one:
#   Windows PowerShell:
#     [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 }))
#   Or, if you have Git Bash / WSL available:
#     openssl rand -base64 32
JWT_SECRET=change_this_secret
# Supported: HS256, HS384, HS512. Asymmetric algorithms (RS256/ES256) are not
# supported - this project signs and verifies with a single shared secret.
JWT_ALGORITHM=HS256
# Expressed in MINUTES here (the Python side's convention). The C++ repo's
# equivalent variable is JWT_EXPIRY_SECS - same meaning, different unit.
JWT_EXPIRY_MINUTES=60


# --- Rate limiting (used only by the security-engine service) ---
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECS=60


# --- Service ports ---
# Each service listens on its own port. Unlike the C++ repo (where every
# service listened on 8080 inside its own container), these are distinct
# because on Windows the services are frequently run natively, side by side
# on one machine - identical ports would collide immediately.
#
# USERS_PORT and SECURITY_ENGINE_PORT are NOT free choices - they match
# what's already hardcoded in the existing, already-tested code
# (services/shared/config.py's PORT default, and
# services/security-engine/app.py's app.run(port=...) call). Changing
# these numbers means editing working code for no functional benefit.
#
# BACKEND_REGISTRY_PORT and MIDDLEWARE_PORT are free choices, since neither
# service exists yet - chosen to match the C++ repo's own numbering
# (backend-registry=8083, middleware=8080) purely as a mental cross-stack
# reference. Not a requirement - change freely before building those services.
#
# Note there is no port 8082 here. In the C++ repo, 8082 was "users" - but
# the Python users-service already existed on 5000 before this numbering was
# ever decided, so the two stacks were never going to line up 1:1. 8082 is
# simply unclaimed, not missing.
USERS_PORT=5000
SECURITY_ENGINE_PORT=8081
BACKEND_REGISTRY_PORT=8083
MIDDLEWARE_PORT=8080


# --- Internal service URLs (used only by the middleware) ---
# These are how the middleware reaches the other services. Under Docker
# Compose the hostnames are the compose service names; when running the
# middleware natively on Windows, override all four to 127.0.0.1:<port>
# in your local .env.
USERS_URL=http://users-service:5000
SECURITY_ENGINE_URL=http://security-engine:8081
BACKEND_REGISTRY_URL=http://backend-registry:8083
# How long the middleware waits on any single internal HTTP call before
# giving up. Without an explicit timeout, one hung service would tie up
# the request forever instead of failing fast.
INTERNAL_CALL_TIMEOUT_SECS=5